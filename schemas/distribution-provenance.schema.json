{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://provenance/distribution/v1",
  "title": "distribution-provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "version",
    "template"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "template": {
      "$ref": "schema://common/repository-path/v1"
    }
  }
}
