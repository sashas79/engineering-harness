{
  "env": {
    "ENGINEERING_HARNESS_ROOT": "{{harness_root}}",
    "ENGINEERING_HARNESS_CORE": "{{harness_core}}"
  },
  "permissions": {
    "allow": ["Bash({{harness_core}}:*)"],
    "deny": [
      "Bash({{harness_core}} approve_pending:*)",
      "Bash({{harness_core}} reject_pending:*)",
      "Bash({{harness_core}} record_specification_decision:*)",
      "Bash({{harness_core}} record_architecture_decision:*)",
      "Bash({{harness_core}} record_work_decision:*)"
    ]
  }
}
