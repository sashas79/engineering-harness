{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://approval/candidate/v1",
  "title": "approval-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "harness",
        "engineering",
        "upstream",
        "artifacts",
        "validation",
        "binding"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "specification",
            "architecture",
            "work"
          ]
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
            }
          }
        },
        "engineering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resolution_digest"
          ],
          "properties": {
            "resolution_digest": {
              "$ref": "schema://common/digest/v1"
            }
          }
        },
        "project_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fingerprint"
          ],
          "properties": {
            "fingerprint": {
              "$ref": "schema://common/digest/v1"
            }
          }
        },
        "upstream": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "baseline_id",
              "digest"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "specification",
                  "architecture",
                  "work"
                ]
              },
              "baseline_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
              },
              "digest": {
                "$ref": "schema://common/digest/v1"
              }
            }
          }
        },
        "ai_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "digest"
          ],
          "properties": {
            "path": {
              "const": "ai/policy.yaml"
            },
            "digest": {
              "$ref": "schema://common/digest/v1"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "$ref": "schema://common/repository-path/v1"
              },
              "digest": {
                "$ref": "schema://common/digest/v1"
              }
            }
          },
          "minItems": 1
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_digest",
            "evidence",
            "evidence_digest"
          ],
          "properties": {
            "subject_digest": {
              "$ref": "schema://common/digest/v1"
            },
            "evidence": {
              "$ref": "schema://common/repository-path/v1"
            },
            "evidence_digest": {
              "$ref": "schema://common/digest/v1"
            }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "canonicalisation",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "canonicalisation": {
              "const": "harness-v1"
            },
            "digest": {
              "$ref": "schema://common/digest/v1"
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "path",
              "digest"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "requirement",
                  "acceptance_criterion",
                  "component",
                  "adr",
                  "contract",
                  "task",
                  "graph_entry",
                  "document"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "$ref": "schema://common/repository-path/v1"
              },
              "digest": {
                "$ref": "schema://common/digest/v1"
              },
              "requirement_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^REQ-"
                }
              },
              "acceptance_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^AC-"
                }
              },
              "change_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^CHG-[0-9]{4}$"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^TASK-"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "task"
                    }
                  }
                },
                "then": {
                  "required": [
                    "requirement_refs",
                    "acceptance_refs",
                    "change_refs",
                    "dependencies"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "requirement_refs"
                        ]
                      },
                      {
                        "required": [
                          "acceptance_refs"
                        ]
                      },
                      {
                        "required": [
                          "change_refs"
                        ]
                      },
                      {
                        "required": [
                          "dependencies"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "change",
            "supersedes",
            "delta"
          ],
          "properties": {
            "change": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "path",
                "digest"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^CHG-[0-9]{4}$"
                },
                "path": {
                  "$ref": "schema://common/repository-path/v1"
                },
                "digest": {
                  "$ref": "schema://common/digest/v1"
                }
              }
            },
            "supersedes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "digest"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(SPEC|ARCH|WORK)-[0-9]{4}$"
                },
                "digest": {
                  "$ref": "schema://common/digest/v1"
                }
              }
            },
            "delta": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifacts",
                "items"
              ],
              "properties": {
                "artifacts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "added",
                    "changed",
                    "removed",
                    "unchanged"
                  ],
                  "properties": {
                    "added": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "digest"
                        ],
                        "properties": {
                          "path": {
                            "$ref": "schema://common/repository-path/v1"
                          },
                          "digest": {
                            "$ref": "schema://common/digest/v1"
                          }
                        }
                      }
                    },
                    "changed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "old_digest",
                          "new_digest"
                        ],
                        "properties": {
                          "path": {
                            "$ref": "schema://common/repository-path/v1"
                          },
                          "old_digest": {
                            "$ref": "schema://common/digest/v1"
                          },
                          "new_digest": {
                            "$ref": "schema://common/digest/v1"
                          }
                        }
                      }
                    },
                    "removed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "digest"
                        ],
                        "properties": {
                          "path": {
                            "$ref": "schema://common/repository-path/v1"
                          },
                          "digest": {
                            "$ref": "schema://common/digest/v1"
                          }
                        }
                      }
                    },
                    "unchanged": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "added",
                    "changed",
                    "removed",
                    "unchanged"
                  ],
                  "properties": {
                    "added": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "id",
                          "digest"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "requirement",
                              "acceptance_criterion",
                              "component",
                              "adr",
                              "contract",
                              "task",
                              "graph_entry",
                              "document"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "digest": {
                            "$ref": "schema://common/digest/v1"
                          }
                        }
                      }
                    },
                    "changed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "id",
                          "old_digest",
                          "new_digest"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "requirement",
                              "acceptance_criterion",
                              "component",
                              "adr",
                              "contract",
                              "task",
                              "graph_entry",
                              "document"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "old_digest": {
                            "$ref": "schema://common/digest/v1"
                          },
                          "new_digest": {
                            "$ref": "schema://common/digest/v1"
                          }
                        }
                      }
                    },
                    "removed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "id",
                          "digest"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "requirement",
                              "acceptance_criterion",
                              "component",
                              "adr",
                              "contract",
                              "task",
                              "graph_entry",
                              "document"
                            ]
                          },
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "digest": {
                            "$ref": "schema://common/digest/v1"
                          }
                        }
                      }
                    },
                    "unchanged": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "requirement": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "acceptance_criterion": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "component": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "adr": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "contract": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "task": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "graph_entry": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "document": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "specification"
              }
            }
          },
          "then": {
            "required": [
              "project_pack"
            ],
            "properties": {
              "upstream": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "ai_policy"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "architecture"
              }
            }
          },
          "then": {
            "properties": {
              "upstream": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "allOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "baseline_id",
                        "digest"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "specification",
                            "architecture",
                            "work"
                          ]
                        },
                        "baseline_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
                        },
                        "digest": {
                          "$ref": "schema://common/digest/v1"
                        }
                      }
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "specification"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "project_pack"
                  ]
                },
                {
                  "required": [
                    "ai_policy"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "work"
              }
            }
          },
          "then": {
            "required": [
              "ai_policy"
            ],
            "properties": {
              "upstream": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "allOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "baseline_id",
                        "digest"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "specification",
                            "architecture",
                            "work"
                          ]
                        },
                        "baseline_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
                        },
                        "digest": {
                          "$ref": "schema://common/digest/v1"
                        }
                      }
                    },
                    {
                      "properties": {
                        "type": {
                          "const": "architecture"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "not": {
              "required": [
                "project_pack"
              ]
            }
          }
        }
      ]
    }
  }
}
