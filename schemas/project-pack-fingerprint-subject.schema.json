{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://project-pack/fingerprint-subject/v1",
  "title": "Project Pack fingerprint subject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fingerprint_subject"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "fingerprint_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "$ref": "schema://common/repository-path/v1"
              },
              "digest": {
                "$ref": "schema://common/digest/v1"
              }
            }
          }
        }
      }
    }
  }
}
