{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://common/issue/v1",
  "title": "issue.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "category",
    "severity",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "PROV_NOT_RECORDED",
        "PROV_NOT_FOUND",
        "PROV_UNSUPPORTED",
        "PROV_INCONSISTENT",
        "REPO_REQUIRED_PATH_MISSING",
        "REPO_WRONG_OBJECT_TYPE",
        "REPO_PATH_ESCAPE",
        "REPO_FORBIDDEN_SYMLINK",
        "REPO_INCONSISTENT_STATE",
        "PACK_REQUIRED_INPUT_MISSING",
        "PACK_PARSE_ERROR",
        "PACK_SCHEMA_INVALID",
        "PACK_SOURCE_UNDECLARED",
        "PACK_SOURCE_NOT_FOUND",
        "PACK_FINGERPRINT_UNCOMPUTABLE",
        "PROFILE_UNKNOWN",
        "TECHNOLOGY_UNKNOWN",
        "CONTROL_UNKNOWN",
        "CONTROL_CONFIG_NOT_PERMITTED",
        "CONTROL_OVERRIDE_NOT_PERMITTED",
        "CONTROL_OVERRIDE_APPROVAL_UNSUPPORTED",
        "CONTROL_CONFLICT",
        "CANONICALISATION_UNSUPPORTED",
        "CANONICALISATION_KEY_COLLISION",
        "YAML_UNSUPPORTED_FEATURE",
        "DIGEST_INVALID",
        "DIGEST_MISMATCH",
        "VALIDATION_FAILED",
        "VALIDATION_ERROR",
        "VALIDATION_SUBJECT_CHANGED",
        "VALIDATION_EVIDENCE_INVALID",
        "APPROVAL_MISSING",
        "APPROVAL_WRONG_CANDIDATE",
        "APPROVAL_WRONG_AUTHORITY",
        "APPROVAL_IDENTITY_ASSURANCE_INVALID",
        "APPROVAL_DECISION_ALREADY_RECORDED",
        "APPROVAL_CANDIDATE_REJECTED",
        "BASELINE_INTEGRITY_FAILURE",
        "BASELINE_UPSTREAM_STALE",
        "BASELINE_MULTIPLE_HEADS",
        "BASELINE_CYCLE",
        "BASELINE_CROSS_TYPE_SUPERSESSION",
        "BASELINE_PREDECESSOR_MISSING",
        "AI_POLICY_INVALID",
        "AI_POLICY_STALE",
        "AI_POLICY_WRONG_ARCHITECTURE",
        "WORK_TASK_DUPLICATE",
        "WORK_REFERENCE_INVALID",
        "WORK_DEPENDENCY_MISSING",
        "WORK_GRAPH_CYCLE",
        "WORK_SCOPE_ESCAPE",
        "WORK_COVERAGE_INCOMPLETE",
        "MUTATION_LOCKED",
        "RECORD_ALREADY_EXISTS",
        "MUTATION_PRECONDITION_CHANGED",
        "ATOMIC_WRITE_FAILED"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "provenance",
        "repository",
        "project_pack",
        "profile_control",
        "canonicalisation_integrity",
        "validation",
        "approval",
        "baseline",
        "ai_policy",
        "work",
        "mutation"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "$ref": "schema://common/repository-path/v1"
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "control": {
      "type": "string",
      "pattern": "^control://"
    },
    "operation": {
      "type": "string",
      "enum": [
        "inspect_project",
        "check_repository_structure",
        "read_provenance",
        "check_project_pack",
        "check_profile_resolution",
        "check_specification",
        "check_architecture",
        "check_work_graph",
        "check_baseline",
        "check_execution_readiness",
        "determine_bootstrap_state",
        "determine_next_action",
        "bootstrap_repository",
        "ingest_specification",
        "validate_specification",
        "record_specification_decision",
        "baseline_specification",
        "derive_architecture",
        "validate_architecture",
        "record_architecture_decision",
        "baseline_architecture",
        "derive_project_ai_policy",
        "generate_work_items",
        "validate_work_graph",
        "record_work_decision",
        "baseline_work"
      ]
    }
  }
}
