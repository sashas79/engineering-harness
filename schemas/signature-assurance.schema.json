{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://approval/signature-assurance/v1",
  "title": "signature-assurance.schema.json",
  "description": "The signer reference shared by every signed record (BRS Section 73.2): the identity where the record has no approver, the key by type and SHA-256 fingerprint, and the signer record that was the head of the signer chain when the record was written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mechanism",
    "level",
    "key",
    "signers"
  ],
  "properties": {
    "mechanism": {
      "const": "ssh-signature"
    },
    "level": {
      "const": "signed"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "fingerprint"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ssh-ed25519",
            "ecdsa-sha2-nistp256",
            "ecdsa-sha2-nistp384",
            "ecdsa-sha2-nistp521",
            "ssh-rsa",
            "sk-ssh-ed25519@openssh.com",
            "sk-ecdsa-sha2-nistp256@openssh.com"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
        }
      }
    },
    "signers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SGN-[0-9]{4}$"
        },
        "digest": {
          "$ref": "schema://common/digest/v1"
        }
      }
    }
  }
}
