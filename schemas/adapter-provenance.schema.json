{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://provenance/adapter/v1",
  "title": "adapter-provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "source"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "source": {
      "$ref": "schema://common/repository-path/v1"
    }
  }
}
