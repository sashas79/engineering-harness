{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://maintenance/change-closure/v1",
  "title": "change-closure.schema.json",
  "description": "Change closure (BRS Section 62.6), evidence/changes/CLO-<nnnn>.yaml: the record `abandon_change` writes. Self digest: closure.binding.digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "change",
        "closed_at",
        "closed_via",
        "binding"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLO-[0-9]{4}$"
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^CHG-[0-9]{4}$"
            },
            "path": {
              "$ref": "schema://common/repository-path/v1"
            },
            "digest": {
              "$ref": "schema://common/digest/v1"
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "closed_at": {
          "$ref": "schema://common/timestamp/v1"
        },
        "closed_via": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interface",
            "caller"
          ],
          "properties": {
            "interface": {
              "type": "string",
              "enum": [
                "cli",
                "ci",
                "adapter",
                "library"
              ]
            },
            "caller": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
            }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "canonicalisation",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "canonicalisation": {
              "const": "harness-v1"
            },
            "digest": {
              "$ref": "schema://common/digest/v1"
            }
          }
        }
      }
    }
  }
}
