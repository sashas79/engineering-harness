{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://intent/specification/v1",
  "title": "specification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "requirements",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "schema://intent/requirement/v1"
          },
          "minItems": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "schema://intent/acceptance-criterion/v1"
          },
          "minItems": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
