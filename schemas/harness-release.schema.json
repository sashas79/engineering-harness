{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://harness/release/v1",
  "title": "harness-release.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "schemas",
        "profiles",
        "technologies",
        "controls",
        "gates"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "bootstrap_workflow": {
          "type": "string",
          "pattern": "^workflow://"
        },
        "schemas": {
          "const": "schemas/schema-catalog.json"
        },
        "profiles": {
          "$ref": "schema://common/repository-path/v1"
        },
        "technologies": {
          "$ref": "schema://common/repository-path/v1"
        },
        "controls": {
          "$ref": "schema://common/repository-path/v1"
        },
        "gates": {
          "$ref": "schema://common/repository-path/v1"
        },
        "core_contract": {
          "type": "integer",
          "minimum": 2
        },
        "workflows": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bootstrap",
            "maintenance",
            "execution"
          ],
          "properties": {
            "bootstrap": {
              "const": "workflow://bootstrap"
            },
            "maintenance": {
              "const": "workflow://maintenance"
            },
            "execution": {
              "const": "workflow://execution"
            }
          }
        },
        "adapters": {
          "$ref": "schema://common/repository-path/v1"
        },
        "adoptable_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "core_contract"
            ]
          },
          "then": {
            "required": [
              "workflows",
              "adapters",
              "adoptable_from"
            ],
            "not": {
              "required": [
                "bootstrap_workflow"
              ]
            }
          },
          "else": {
            "required": [
              "bootstrap_workflow"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "workflows"
                  ]
                },
                {
                  "required": [
                    "adapters"
                  ]
                },
                {
                  "required": [
                    "adoptable_from"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
