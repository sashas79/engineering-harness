{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://approval/baseline/v1",
  "title": "baseline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "candidate",
        "approval",
        "established_at",
        "repository",
        "supersedes",
        "binding"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SPEC|ARCH|WORK)-[0-9]{4}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "specification",
            "architecture",
            "work"
          ]
        },
        "candidate": {
          "$ref": "schema://common/evidence-reference/v1"
        },
        "approval": {
          "$ref": "schema://common/evidence-reference/v1"
        },
        "established_at": {
          "$ref": "schema://common/timestamp/v1"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git_commit"
          ],
          "properties": {
            "git_commit": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{7,64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "path",
                "digest"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(SPEC|ARCH|WORK)-[0-9]{4}$"
                },
                "path": {
                  "$ref": "schema://common/repository-path/v1"
                },
                "digest": {
                  "$ref": "schema://common/digest/v1"
                }
              }
            }
          ]
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "canonicalisation",
            "digest"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "canonicalisation": {
              "const": "harness-v1"
            },
            "digest": {
              "$ref": "schema://common/digest/v1"
            }
          }
        }
      }
    }
  }
}
