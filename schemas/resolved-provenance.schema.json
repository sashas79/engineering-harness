{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://provenance/resolved/v1",
  "title": "resolved-provenance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "profile",
        "project_pack_fingerprint"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        },
        "project_pack_fingerprint": {
          "$ref": "schema://common/digest/v1"
        }
      }
    }
  }
}
