{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://project-pack/harness-profile/v1",
  "title": "harness-profile-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness_profile"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "harness_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
        }
      }
    }
  }
}
