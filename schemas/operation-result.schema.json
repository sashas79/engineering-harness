{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://result/operation/v1",
  "title": "operation-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "outcome",
    "provenance",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "inspect_project",
        "check_repository_structure",
        "read_provenance",
        "check_project_pack",
        "check_profile_resolution",
        "check_specification",
        "check_architecture",
        "check_work_graph",
        "check_baseline",
        "check_execution_readiness",
        "determine_bootstrap_state",
        "determine_next_action",
        "bootstrap_repository",
        "ingest_specification",
        "validate_specification",
        "record_specification_decision",
        "baseline_specification",
        "derive_architecture",
        "validate_architecture",
        "record_architecture_decision",
        "baseline_architecture",
        "derive_project_ai_policy",
        "generate_work_items",
        "validate_work_graph",
        "record_work_decision",
        "baseline_work",
        "check_maintenance",
        "check_adapters",
        "check_signers",
        "list_tasks",
        "select_task",
        "open_change",
        "abandon_change",
        "start_task",
        "record_task_progress",
        "block_task",
        "complete_task",
        "reopen_task",
        "record_task_decision",
        "record_change_decision",
        "enrol_signer",
        "revoke_signer"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "OK",
        "INCOMPLETE",
        "INVALID",
        "BLOCKED",
        "ERROR"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_status"
      ],
      "properties": {
        "resolution_status": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "NOT_RECORDED",
            "NOT_FOUND",
            "UNSUPPORTED",
            "INCONSISTENT"
          ]
        },
        "harness_version": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness_root": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "installed_adapters": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "progress"
      ],
      "properties": {
        "state": {
          "$ref": "schema://lifecycle/state/v1"
        },
        "progress": {
          "$ref": "schema://lifecycle/progress/v1"
        }
      }
    },
    "project_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "fingerprint_status",
        "observed_fingerprint",
        "validated_fingerprint",
        "resolution_source_fingerprint"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "fingerprint_status": {
          "type": "string",
          "enum": [
            "COMPUTABLE",
            "UNCOMPUTABLE",
            "NOT_APPLICABLE"
          ]
        },
        "observed_fingerprint": {
          "oneOf": [
            {
              "$ref": "schema://common/digest/v1"
            },
            {
              "type": "null"
            }
          ]
        },
        "validated_fingerprint": {
          "oneOf": [
            {
              "$ref": "schema://common/digest/v1"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_source_fingerprint": {
          "oneOf": [
            {
              "$ref": "schema://common/digest/v1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "valid",
        "current",
        "resolution_digest"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        },
        "resolution_digest": {
          "oneOf": [
            {
              "$ref": "schema://common/digest/v1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integrity",
            "historical_validity",
            "currentness",
            "lineage_position"
          ],
          "properties": {
            "integrity": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "error",
                "absent"
              ]
            },
            "historical_validity": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "indeterminate",
                "absent"
              ]
            },
            "currentness": {
              "type": "string",
              "enum": [
                "current",
                "stale",
                "indeterminate",
                "absent"
              ]
            },
            "lineage_position": {
              "type": "string",
              "enum": [
                "head",
                "superseded",
                "invalid",
                "absent"
              ]
            },
            "approval_assurance": {
              "type": "string",
              "enum": [
                "signed",
                "declared"
              ]
            },
            "upstream_declared": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "specification",
                  "architecture"
                ]
              }
            }
          }
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integrity",
            "historical_validity",
            "currentness",
            "lineage_position"
          ],
          "properties": {
            "integrity": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "error",
                "absent"
              ]
            },
            "historical_validity": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "indeterminate",
                "absent"
              ]
            },
            "currentness": {
              "type": "string",
              "enum": [
                "current",
                "stale",
                "indeterminate",
                "absent"
              ]
            },
            "lineage_position": {
              "type": "string",
              "enum": [
                "head",
                "superseded",
                "invalid",
                "absent"
              ]
            },
            "approval_assurance": {
              "type": "string",
              "enum": [
                "signed",
                "declared"
              ]
            },
            "upstream_declared": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "specification",
                  "architecture"
                ]
              }
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integrity",
            "historical_validity",
            "currentness",
            "lineage_position"
          ],
          "properties": {
            "integrity": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "error",
                "absent"
              ]
            },
            "historical_validity": {
              "type": "string",
              "enum": [
                "valid",
                "invalid",
                "indeterminate",
                "absent"
              ]
            },
            "currentness": {
              "type": "string",
              "enum": [
                "current",
                "stale",
                "indeterminate",
                "absent"
              ]
            },
            "lineage_position": {
              "type": "string",
              "enum": [
                "head",
                "superseded",
                "invalid",
                "absent"
              ]
            },
            "approval_assurance": {
              "type": "string",
              "enum": [
                "signed",
                "declared"
              ]
            },
            "upstream_declared": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "specification",
                  "architecture"
                ]
              }
            }
          }
        }
      }
    },
    "ai_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "valid",
        "current"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "work_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "valid"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        }
      }
    },
    "execution_permitted": {
      "type": "boolean"
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocking_conditions": {
      "type": "array",
      "items": {
        "$ref": "schema://lifecycle/blocking-condition/v1"
      }
    },
    "pending_gate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate",
            "candidate_path",
            "candidate_digest"
          ],
          "properties": {
            "gate": {
              "type": "string",
              "pattern": "^gate://"
            },
            "candidate_path": {
              "$ref": "schema://common/repository-path/v1"
            },
            "candidate_digest": {
              "$ref": "schema://common/digest/v1"
            },
            "authority": {
              "type": "string",
              "description": "Core contract 2 (RUL-63): the authority of the gate."
            },
            "approver": {
              "type": [
                "string",
                "null"
              ],
              "description": "Core contract 2 (RUL-63): the identity the Project Pack assigns to the gate's authority, which signs the decision; null when the Pack names none."
            },
            "revision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "change",
                "supersedes",
                "delta"
              ],
              "properties": {
                "change": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "path",
                    "digest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^CHG-[0-9]{4}$"
                    },
                    "path": {
                      "$ref": "schema://common/repository-path/v1"
                    },
                    "digest": {
                      "$ref": "schema://common/digest/v1"
                    }
                  }
                },
                "supersedes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "digest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^(SPEC|ARCH|WORK)-[0-9]{4}$"
                    },
                    "digest": {
                      "$ref": "schema://common/digest/v1"
                    }
                  }
                },
                "delta": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifacts",
                    "items"
                  ],
                  "properties": {
                    "artifacts": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "added",
                        "changed",
                        "removed",
                        "unchanged"
                      ],
                      "properties": {
                        "added": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "digest"
                            ],
                            "properties": {
                              "path": {
                                "$ref": "schema://common/repository-path/v1"
                              },
                              "digest": {
                                "$ref": "schema://common/digest/v1"
                              }
                            }
                          }
                        },
                        "changed": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "old_digest",
                              "new_digest"
                            ],
                            "properties": {
                              "path": {
                                "$ref": "schema://common/repository-path/v1"
                              },
                              "old_digest": {
                                "$ref": "schema://common/digest/v1"
                              },
                              "new_digest": {
                                "$ref": "schema://common/digest/v1"
                              }
                            }
                          }
                        },
                        "removed": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "digest"
                            ],
                            "properties": {
                              "path": {
                                "$ref": "schema://common/repository-path/v1"
                              },
                              "digest": {
                                "$ref": "schema://common/digest/v1"
                              }
                            }
                          }
                        },
                        "unchanged": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "added",
                        "changed",
                        "removed",
                        "unchanged"
                      ],
                      "properties": {
                        "added": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "id",
                              "digest"
                            ],
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "requirement",
                                  "acceptance_criterion",
                                  "component",
                                  "adr",
                                  "contract",
                                  "task",
                                  "graph_entry",
                                  "document"
                                ]
                              },
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "digest": {
                                "$ref": "schema://common/digest/v1"
                              }
                            }
                          }
                        },
                        "changed": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "id",
                              "old_digest",
                              "new_digest"
                            ],
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "requirement",
                                  "acceptance_criterion",
                                  "component",
                                  "adr",
                                  "contract",
                                  "task",
                                  "graph_entry",
                                  "document"
                                ]
                              },
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "old_digest": {
                                "$ref": "schema://common/digest/v1"
                              },
                              "new_digest": {
                                "$ref": "schema://common/digest/v1"
                              }
                            }
                          }
                        },
                        "removed": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "kind",
                              "id",
                              "digest"
                            ],
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "requirement",
                                  "acceptance_criterion",
                                  "component",
                                  "adr",
                                  "contract",
                                  "task",
                                  "graph_entry",
                                  "document"
                                ]
                              },
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "digest": {
                                "$ref": "schema://common/digest/v1"
                              }
                            }
                          }
                        },
                        "unchanged": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "requirement": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "acceptance_criterion": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "component": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "adr": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "contract": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "task": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "graph_entry": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "document": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "next_action": {
      "oneOf": [
        {
          "$ref": "schema://lifecycle/next-action/v1"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "schema://common/evidence-reference/v1"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "schema://common/issue/v1"
      }
    },
    "regime": {
      "type": "string",
      "enum": [
        "bootstrap",
        "maintenance"
      ]
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changes",
        "revision"
      ],
      "properties": {
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "digest",
              "kind",
              "origin",
              "reach",
              "status",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CHG-[0-9]{4}$"
              },
              "path": {
                "$ref": "schema://common/repository-path/v1"
              },
              "digest": {
                "$ref": "schema://common/digest/v1"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "defect",
                  "follow_up",
                  "new_requirement",
                  "documentation"
                ]
              },
              "origin": {
                "type": "string",
                "enum": [
                  "planned",
                  "registered"
                ]
              },
              "reach": {
                "type": "string",
                "enum": [
                  "none",
                  "execution",
                  "work",
                  "architecture",
                  "specification"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "superseded",
                  "abandoned",
                  "rejected",
                  "accepted",
                  "awaiting_decision",
                  "in_revision",
                  "open",
                  "completed",
                  "completed_with_open_items",
                  "in_execution"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": "string",
                "pattern": "^CHG-[0-9]{4}$"
              },
              "superseded_by": {
                "type": "string",
                "pattern": "^CHG-[0-9]{4}$"
              },
              "rework": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^TASK-[A-Za-z0-9._-]+$"
                }
              },
              "work_items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^TASK-[A-Za-z0-9._-]+$"
                }
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^CHG-[0-9]{4}-AC-[0-9]{2}$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "closed"
                      ]
                    }
                  }
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "change",
                "reach",
                "chain"
              ],
              "properties": {
                "change": {
                  "type": "string",
                  "pattern": "^CHG-[0-9]{4}$"
                },
                "reach": {
                  "type": "string",
                  "enum": [
                    "none",
                    "execution",
                    "work",
                    "architecture",
                    "specification"
                  ]
                },
                "chain": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "specification",
                        "architecture",
                        "work"
                      ]
                    }
                  ]
                },
                "waiting": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^CHG-[0-9]{4}$"
                  }
                }
              }
            }
          ]
        },
        "outside_run": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "$ref": "schema://common/repository-path/v1"
              },
              "digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "schema://common/digest/v1"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "next_task"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "deferred": {
              "type": "integer",
              "minimum": 0
            },
            "withdrawn": {
              "type": "integer",
              "minimum": 0
            },
            "awaiting_baseline": {
              "type": "integer",
              "minimum": 0
            },
            "gated": {
              "type": "integer",
              "minimum": 0
            },
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "in_progress": {
              "type": "integer",
              "minimum": 0
            },
            "blocked": {
              "type": "integer",
              "minimum": 0
            },
            "rework_required": {
              "type": "integer",
              "minimum": 0
            },
            "pending": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "next_task": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^TASK-[A-Za-z0-9._-]+$"
            }
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "ready",
              "dependencies"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^TASK-[A-Za-z0-9._-]+$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "deferred",
                  "withdrawn",
                  "awaiting_baseline",
                  "gated",
                  "done",
                  "in_progress",
                  "blocked",
                  "rework_required",
                  "pending"
                ]
              },
              "ready": {
                "type": "boolean"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^TASK-"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "definition_digest": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "schema://common/digest/v1"
                  }
                ]
              },
              "run": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^RUN-[0-9]{4}$"
                  }
                ]
              },
              "disposition": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^DEC-[0-9]{4}$"
                  }
                ]
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "path"
            ],
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "$ref": "schema://common/repository-path/v1"
              },
              "status": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "in_progress",
                      "blocked",
                      "done"
                    ]
                  }
                ]
              }
            }
          }
        },
        "open_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "not_delivered",
              "open_by_disposition",
              "done",
              "not_done"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "specification",
                  "change"
                ]
              },
              "not_delivered": {
                "type": "boolean"
              },
              "open_by_disposition": {
                "type": "boolean"
              },
              "done": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^TASK-[A-Za-z0-9._-]+$"
                }
              },
              "not_done": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "status"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^TASK-[A-Za-z0-9._-]+$"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "deferred",
                        "withdrawn",
                        "awaiting_baseline",
                        "gated",
                        "done",
                        "in_progress",
                        "blocked",
                        "rework_required",
                        "pending",
                        "not_in_task_set"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "decision",
              "disposition",
              "state"
            ],
            "properties": {
              "task": {
                "type": "string",
                "pattern": "^TASK-[A-Za-z0-9._-]+$"
              },
              "decision": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^DEC-[0-9]{4}$"
                  }
                ]
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "deferred",
                  "withdrawn"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "in_force",
                  "ended"
                ]
              },
              "definition": {
                "type": "string",
                "enum": [
                  "current",
                  "earlier"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "type": "string",
                "pattern": "^CHG-[0-9]{4}$"
              }
            }
          }
        },
        "not_executable": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[A-Za-z0-9._-]+$"
          }
        },
        "selected": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^TASK-[A-Za-z0-9._-]+$"
                },
                "definition": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "digest"
                  ],
                  "properties": {
                    "path": {
                      "$ref": "schema://common/repository-path/v1"
                    },
                    "digest": {
                      "$ref": "schema://common/digest/v1"
                    }
                  }
                },
                "document": {
                  "type": "object"
                },
                "run": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object"
                    }
                  ]
                },
                "permitted_operations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "start_task",
                      "record_task_progress",
                      "block_task",
                      "complete_task",
                      "reopen_task"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "permitted_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "actor"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "bootstrap_repository",
              "ingest_specification",
              "validate_specification",
              "record_specification_decision",
              "baseline_specification",
              "derive_architecture",
              "validate_architecture",
              "record_architecture_decision",
              "baseline_architecture",
              "derive_project_ai_policy",
              "generate_work_items",
              "validate_work_graph",
              "record_work_decision",
              "baseline_work",
              "open_change",
              "abandon_change",
              "start_task",
              "record_task_progress",
              "block_task",
              "complete_task",
              "reopen_task",
              "record_task_decision",
              "record_change_decision",
              "enrol_signer",
              "revoke_signer"
            ]
          },
          "actor": {
            "type": "string",
            "enum": [
              "adapter",
              "operator"
            ]
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "task": {
                "type": "string",
                "pattern": "^TASK-[A-Za-z0-9._-]+$"
              },
              "change": {
                "type": "string",
                "pattern": "^CHG-[0-9]{4}$"
              }
            }
          }
        }
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
          },
          "files": {
            "type": "string",
            "enum": [
              "match",
              "differ"
            ]
          }
        }
      }
    },
    "signers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "anchor",
        "enrolled_keys"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "enum": [
            "valid",
            "invalid",
            "absent"
          ]
        },
        "anchor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "digest",
                "identity",
                "key"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^SGN-[0-9]{4}$"
                },
                "digest": {
                  "$ref": "schema://common/digest/v1"
                },
                "identity": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
                },
                "key": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "fingerprint"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "ssh-ed25519",
                        "ecdsa-sha2-nistp256",
                        "ecdsa-sha2-nistp384",
                        "ecdsa-sha2-nistp521",
                        "ssh-rsa",
                        "sk-ssh-ed25519@openssh.com",
                        "sk-ecdsa-sha2-nistp256@openssh.com"
                      ]
                    },
                    "fingerprint": {
                      "type": "string",
                      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
                    }
                  }
                },
                "captured_at": {
                  "$ref": "schema://common/timestamp/v1"
                }
              }
            }
          ]
        },
        "enrolled_keys": {
          "type": "integer",
          "minimum": 0
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity",
              "key",
              "status",
              "enrolled_by"
            ],
            "properties": {
              "identity": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
              },
              "key": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "fingerprint"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "ssh-ed25519",
                      "ecdsa-sha2-nistp256",
                      "ecdsa-sha2-nistp384",
                      "ecdsa-sha2-nistp521",
                      "ssh-rsa",
                      "sk-ssh-ed25519@openssh.com",
                      "sk-ecdsa-sha2-nistp256@openssh.com"
                    ]
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
                  }
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "enrolled",
                  "revoked"
                ]
              },
              "enrolled_by": {
                "type": "string",
                "pattern": "^SGN-[0-9]{4}$"
              },
              "revoked_by": {
                "type": "string",
                "pattern": "^SGN-[0-9]{4}$"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "message"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "single_key",
                  "identity_without_key"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"
              },
              "authorities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allowed_signers": {
          "type": "string"
        }
      }
    }
  }
}
