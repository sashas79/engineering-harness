{
  "permissions": {
    "allow": [
      "Bash(./harness *)"
    ],
    "deny": [
      "Bash(./harness record_specification_decision *)",
      "Bash(./harness record_architecture_decision *)",
      "Bash(./harness record_work_decision *)",
      "Bash(./harness record_task_decision *)",
      "Bash(./harness record_change_decision *)",
      "Bash(./harness approve_pending *)",
      "Bash(./harness reject_pending *)",
      "Bash(./harness adopt_release *)",
      "Bash(./harness enrol_signer *)",
      "Bash(./harness revoke_signer *)",
      "Bash(./harness trust_signers *)",
      "Bash(./harness adapter_add *)",
      "Bash(./harness adapter_remove *)",
      "Bash(./harness adapter_sync *)",
      "Bash(ssh-keygen -Y sign *)",
      "Edit(/spec/**)",
      "Edit(/architecture/**)",
      "Edit(/engineering/**)",
      "Edit(/ai/**)",
      "Edit(/work/tasks/**)",
      "Edit(/work/execution-graph.yaml)",
      "Edit(/work/state/**)",
      "Edit(/baselines/**)",
      "Edit(/evidence/**)",
      "Edit(/.engineering-harness-template)",
      "Edit(/.engineering-harness-adapters)",
      "Edit(/harness)",
      "Edit(/harness.cmd)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/commands/bootstrap.md)",
      "Edit(/.claude/commands/execute.md)",
      "Edit(/.claude/commands/maintain.md)",
      "Edit(/.agents/skills/bootstrap/**)",
      "Edit(/.agents/skills/execute/**)",
      "Edit(/.agents/skills/maintain/**)",
      "Edit(/.codex/rules/engineering-harness.rules)",
      "Edit(/.codex/hooks.json)",
      "Edit(/.github/skills/bootstrap/**)",
      "Edit(/.github/skills/execute/**)",
      "Edit(/.github/skills/maintain/**)",
      "Edit(/.github/hooks/engineering-harness.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}\"; [ -x \"$d/harness\" ] || exit 0; exec \"$d/harness\" adapter_guard",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
